# Keep repository text files consistent across Windows and Linux environments.
* text=auto eol=lf

# Windows command scripts require CRLF for compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binary formats must never be newline-normalized.
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.zip binary
*.7z binary
*.exe binary
*.dll binary
*.so binary
*.pyc binary
